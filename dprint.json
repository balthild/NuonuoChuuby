{
	"excludes": [
		"!.vscode",
		".build",
		"Vendor",
		"Sources/NuonuoChuubyCore/Asset/AssetManifest.swift",
	],
	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,
	"json": {
		"associations": ["*.{json,jsonc}", ".swift-format"],
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": [
			"dprint.json",
			".vscode/settings.json",
			".vscode/launch.json",
		],
	},
	"markdown": {
		"textWrap": "always",
		"table.cellPadding": "space",
		"wrapUnspacedScripts": true,
		"overrides": {
			"files": ["README.md"],
			"textWrap": "never",
		},
	},
	"shuck": {
		"spaceRedirects": true,
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "swift format {{file_path}}",
				"exts": ["swift"],
				"cacheKeyFiles": [".swift-format"],
				"stdin": false,
			},
		],
	},
	"plugins": [
		"npm:@dprint/json@0.25.2",
		"npm:@dprint/markdown@0.28.2",
		"npm:@dprint/shuck@0.2.2",
		"npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
	],
}
