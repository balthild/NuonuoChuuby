root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,json,swift-format,sh,rb}]
indent_style = tab
indent_size = 2

# Build products, and the upstream submodule, which is not ours to restyle.
[{.build,.index-build,Vendor}/**]
indent_style = unset
indent_size = unset
